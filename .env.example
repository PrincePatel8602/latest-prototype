# Copy this file to .env and fill in values. NEVER commit .env.
# Leave a key empty to run that part in DEMO mode.

# DEMO_MODE=true  -> NO external calls at all. Everything uses built-in demo data
#                    (deterministic - the safest setting for a live presentation).
# DEMO_MODE=false -> try live APIs first; each source falls back to demo data
#                    (clearly labeled in the UI) if its key is missing or it fails.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000

# LLM provider for query understanding . Only the question text is sent.
# LLM_PROVIDER: gemini | anthropic | openai.  LLM_MODEL empty = provider default.
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=

# Live data providers (Phase 4)
# Finnhub - free key: https://finnhub.io
MARKET_API_KEY=
# NewsAPI - free key: https://newsapi.org
NEWS_API_KEY=
# Weather needs NO key: it uses the public NOAA National Hurricane Center feed.

# Vector DB - semantic layer for historical events (Phase 11). Empty key = structured-only retrieval (reported in the API).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=aegis-historical
PINECONE_NAMESPACE=aegis-historical-events

# PostgreSQL - source of truth for historical storms/track points (Phase 11)
DATABASE_URL=postgresql://finsight:finsight@localhost:5432/finsight

# Frontend (this one is public by design - it is only a URL, not a secret)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Historical market/macro data (Phase 12). Free keys: https://fred.stlouisfed.org/docs/api/api_key.html and https://www.eia.gov/opendata/
FRED_API_KEY=
EIA_API_KEY=
