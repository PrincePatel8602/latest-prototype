# --- PostgreSQL (source of truth)
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@localhost:5432/aegis
# --- Pinecone (semantic layer). Leave PINECONE_API_KEY empty to run structured-only (reported explicitly).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=aegis-historical
PINECONE_NAMESPACE=aegis-historical-events
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
# --- optional
# HISTORICAL_BACKEND=local     # force the Phase 9 bundled-JSON path
# HISTORICAL_DATA_DIR=         # default: backend/data
